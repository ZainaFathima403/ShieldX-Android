<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/shieldx_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ShieldX"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="Link &amp; message protection for this device"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <!-- Stat grid: 2x2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp"
            android:weightSum="2">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp">
                <TextView android:id="@+id/statThreats" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="@color/danger" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Threats Blocked" android:textColor="@color/text_dim" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp">
                <TextView android:id="@+id/statScans" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Scans Today" android:textColor="@color/text_dim" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:weightSum="2">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp">
                <TextView android:id="@+id/statScore" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="100" android:textColor="@color/safe" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Safety Score" android:textColor="@color/text_dim" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp">
                <TextView android:id="@+id/statWarn" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="@color/warn" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Suspicious Flags" android:textColor="@color/text_dim" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status / default handler card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/statusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 ShieldX is running"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Link scanning is available via &quot;Open with&quot; / Share menus. Tap below to make it the default handler for links tapped elsewhere on your phone."
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <Button
                android:id="@+id/setDefaultButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/accent"
                android:text="Set ShieldX as Default Link Handler"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Screenshot Scanner shortcut (no longer has its own bottom-nav tab —
             BottomNavigationView caps out at 5 items) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Screenshot Scanner"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload a screenshot of a message or email to extract and check the text"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/openScreenshotScanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/accent"
                android:text="Open Screenshot Scanner"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Recent activity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Activity"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/clearAllActivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear All"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:padding="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/activityList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
